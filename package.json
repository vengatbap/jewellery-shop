{
    "name": "auric-one-monorepo",
    "version": "1.0.0",
    "description": "Auric One Enterprise Platform - Domain-Driven Microservices",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "turbo run dev --parallel",
        "dev:accounting": "pnpm --filter=@auric-one/accounting-service run dev",
        "dev:api": "pnpm --filter=@auric-one/api run dev",
        "dev:billing": "pnpm --filter=@auric-one/billing-service run dev",
        "dev:catalog": "pnpm --filter=@auric-one/catalog-service run dev",
        "dev:configuration": "pnpm --filter=@auric-one/configuration-service run dev",
        "dev:customers": "pnpm --filter=@auric-one/customer-service run dev",
        "dev:ecommerce": "pnpm --filter=@auric-one/ecommerce-service run dev",
        "dev:gold-loan": "pnpm --filter=@auric-one/gold-loan-service run dev",
        "dev:gold-rate": "pnpm --filter=@auric-one/gold-rate-service run dev",
        "dev:inventory": "pnpm --filter=@auric-one/inventory-service run dev",
        "dev:multibranch": "pnpm --filter=@auric-one/multibranch-service run dev",
        "dev:procurement": "pnpm --filter=@auric-one/procurement-service run dev",
        "dev:product": "pnpm --filter=@auric-one/product-service run dev",
        "dev:repair": "pnpm --filter=@auric-one/repair-service run dev",
        "dev:reporting": "pnpm --filter=@auric-one/reporting-service run dev",
        "dev:scheme": "pnpm --filter=@auric-one/scheme-service run dev",
        "dev:web": "pnpm --filter=@auric-one/web run dev",
        "build": "turbo run build",
        "build:accounting": "pnpm --filter=@auric-one/accounting-service run build",
        "build:api": "pnpm --filter=@auric-one/api run build",
        "build:billing": "pnpm --filter=@auric-one/billing-service run build",
        "build:catalog": "pnpm --filter=@auric-one/catalog-service run build",
        "build:configuration": "pnpm --filter=@auric-one/configuration-service run build",
        "build:customers": "pnpm --filter=@auric-one/customer-service run build",
        "build:ecommerce": "pnpm --filter=@auric-one/ecommerce-service run build",
        "build:gold-loan": "pnpm --filter=@auric-one/gold-loan-service run build",
        "build:gold-rate": "pnpm --filter=@auric-one/gold-rate-service run build",
        "build:inventory": "pnpm --filter=@auric-one/inventory-service run build",
        "build:multibranch": "pnpm --filter=@auric-one/multibranch-service run build",
