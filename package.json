        "build:reporting": "pnpm --filter=@auric-one/reporting-service run build",
        "build:scheme": "pnpm --filter=@auric-one/scheme-service run build",
        "build:web": "pnpm --filter=@auric-one/web run build",
        "start:accounting": "pnpm --filter=@auric-one/accounting-service run start",
        "start:api": "pnpm --filter=@auric-one/api run start",
        "start:billing": "pnpm --filter=@auric-one/billing-service run start",
        "start:catalog": "pnpm --filter=@auric-one/catalog-service run start",
        "start:configuration": "pnpm --filter=@auric-one/configuration-service run start",
        "start:customers": "pnpm --filter=@auric-one/customer-service run start",
        "start:ecommerce": "pnpm --filter=@auric-one/ecommerce-service run start",
        "start:gold-loan": "pnpm --filter=@auric-one/gold-loan-service run start",
        "start:gold-rate": "pnpm --filter=@auric-one/gold-rate-service run start",
        "start:inventory": "pnpm --filter=@auric-one/inventory-service run start",
        "start:multibranch": "pnpm --filter=@auric-one/multibranch-service run start",
        "start:procurement": "pnpm --filter=@auric-one/procurement-service run start",
        "start:product": "pnpm --filter=@auric-one/product-service run start",
        "start:repair": "pnpm --filter=@auric-one/repair-service run start",
        "start:reporting": "pnpm --filter=@auric-one/reporting-service run start",
        "start:scheme": "pnpm --filter=@auric-one/scheme-service run start",
        "start:web": "pnpm --filter=@auric-one/web run start",
        "lint": "turbo run lint",
        "format": "turbo run format",
        "typecheck": "turbo run typecheck",
        "db:migrate": "pnpm --filter=@auric-one/database run migrate",
        "db:seed": "pnpm --filter=@auric-one/database run seed",
        "db:generate": "pnpm --filter=@auric-one/database run generate",
        "clean": "turbo run clean --no-cache && pnpm -r exec rm -rf node_modules dist .next"
    },
    "devDependencies": {
        "@types/node": "^20.17.10",
        "turbo": "^2.0.0",
        "typescript": "^5.3.0",
        "ts-node": "^10.9.0"
    },
    "packageManager": "pnpm@8.15.9",
    "engines": {
      "node": ">=20.0.0"
    }
}
